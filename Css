/* ==========================================
   PART 2B
   Gallery • Surprise • Premium Effects
========================================== */

/* ------------------------------
   Photo Gallery
------------------------------ */

.gallery{

    text-align:center;

}

.gallery h1{

    font-size:3rem;

    margin-bottom:50px;

    color:#ff8dc7;

    font-family:'Dancing Script',cursive;

}

.photos{

    display:grid;

    grid-template-columns:repeat(auto-fit,minmax(260px,1fr));

    gap:30px;

}

.photos img{

    width:100%;

    border-radius:22px;

    cursor:pointer;

    transition:.5s;

    border:3px solid rgba(255,255,255,.15);

    box-shadow:
    0 15px 40px rgba(0,0,0,.4);

}

.photos img:hover{

    transform:scale(1.05) rotate(-2deg);

    box-shadow:
    0 20px 45px rgba(255,80,150,.35);

}

/* ------------------------------
   Surprise Section
------------------------------ */

.surprise{

    text-align:center;

    padding:120px 20px;

}

.surprise h1{

    font-size:3rem;

    color:#ff7eb3;

    margin-bottom:40px;

}

#surpriseBtn{

    font-size:20px;

    padding:18px 45px;

    border-radius:40px;

    background:linear-gradient(45deg,#ff4f9a,#ff7eb3,#ffd166);

    background-size:300%;

    animation:buttonGlow 6s infinite;

}

@keyframes buttonGlow{

0%{

background-position:left;

}

50%{

background-position:right;

}

100%{

background-position:left;

}

}

/* ------------------------------
   Ending
------------------------------ */

.ending{

    min-height:100vh;

    display:flex;

    flex-direction:column;

    justify-content:center;

    align-items:center;

    text-align:center;

}

.ending h1{

    font-family:'Dancing Script',cursive;

    font-size:4rem;

    color:#ff8dc7;

}

.ending p{

    max-width:700px;

    margin:30px auto;

    font-size:22px;

    color:#ddd;

    line-height:1.8;

}

.ending h2{

    color:#ffd166;

}

/* ------------------------------
   QR Section
------------------------------ */

.qr{

    text-align:center;

}

.qr img{

    width:220px;

    margin-top:30px;

    border-radius:18px;

    background:white;

    padding:12px;

}

/* ------------------------------
   Floating Hearts
------------------------------ */

.heart{

    position:fixed;

    width:18px;

    height:18px;

    background:#ff4f9a;

    transform:rotate(45deg);

    pointer-events:none;

    animation:floatHeart 5s linear forwards;

}

.heart::before,
.heart::after{

content:"";

position:absolute;

width:18px;

height:18px;

background:#ff4f9a;

border-radius:50%;

}

.heart::before{

top:-9px;
left:0;

}

.heart::after{

left:-9px;
top:0;

}

@keyframes floatHeart{

0%{

opacity:1;

transform:
translateY(0)
rotate(45deg)
scale(.4);

}

100%{

opacity:0;

transform:
translateY(-500px)
rotate(45deg)
scale(1.4);

}

}

/* ------------------------------
   Sparkles
------------------------------ */

.sparkle{

position:fixed;

width:4px;

height:4px;

background:white;

border-radius:50%;

box-shadow:

0 0 10px white,

0 0 20px pink;

animation:twinkle 2s infinite;

}

@keyframes twinkle{

0%{

opacity:.2;

transform:scale(.5);

}

50%{

opacity:1;

transform:scale(1.5);

}

100%{

opacity:.2;

transform:scale(.5);

}

}

/* ------------------------------
   Falling Petals
------------------------------ */

.petal{

position:fixed;

top:-50px;

width:20px;

height:20px;

background:#ff7eb3;

border-radius:60% 40% 70% 30%;

opacity:.8;

animation:fall linear forwards;

}

@keyframes fall{

0%{

transform:
translateY(-50px)
rotate(0deg);

}

100%{

transform:
translateY(120vh)
rotate(720deg);

}

}

/* ------------------------------
   Glass Cards
------------------------------ */

.card{

background:rgba(255,255,255,.08);

backdrop-filter:blur(18px);

border-radius:25px;

padding:30px;

border:1px solid rgba(255,255,255,.12);

box-shadow:

0 15px 40px rgba(0,0,0,.35);

}

/* ------------------------------
   Scrollbar
------------------------------ */

::-webkit-scrollbar{

width:8px;

}

::-webkit-scrollbar-track{

background:#111;

}

::-webkit-scrollbar-thumb{

background:#ff4f9a;

border-radius:20px;

}

/* ------------------------------
   Mobile
------------------------------ */

@media(max-width:768px){

.hero h1{

font-size:2.8rem;

}

.gallery h1{

font-size:2.2rem;

}

.surprise h1{

font-size:2.2rem;

}

.ending h1{

font-size:2.8rem;

}

.photos{

grid-template-columns:1fr;

}

button{

width:100%;

}

}
