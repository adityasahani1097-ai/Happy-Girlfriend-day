/* ==========================================
   OUR LITTLE UNIVERSE ❤️
   Premium Romantic Theme
========================================== */

*{
    margin:0;
    padding:0;
    box-sizing:border-box;
}

html{
    scroll-behavior:smooth;
}

body{

    font-family:'Poppins',sans-serif;

    background:#06070d;

    color:white;

    overflow-x:hidden;

}

/* Animated Background */

#background{

    position:fixed;

    inset:0;

    background:
    radial-gradient(circle at top,#ff4f9a22 0%,transparent 45%),
    radial-gradient(circle at bottom,#8a2be222 0%,transparent 45%),
    linear-gradient(180deg,#05060d,#111827);

    z-index:-10;

}

/* Glass Card */

.glass{

    background:rgba(255,255,255,.08);

    backdrop-filter:blur(18px);

    border:1px solid rgba(255,255,255,.15);

    border-radius:25px;

    box-shadow:
    0 0 40px rgba(255,105,180,.25);

}

/* Password Page */

#loginPage{

    width:100%;

    height:100vh;

    display:flex;

    align-items:center;

    justify-content:center;

}

#loginPage .glass{

    width:360px;

    padding:40px;

    text-align:center;

}

#loginPage h1{

    font-size:2rem;

    color:#ff7eb3;

    margin-bottom:15px;

}

#loginPage p{

    color:#ddd;

    margin-bottom:25px;

}

input{

    width:100%;

    padding:14px;

    border:none;

    border-radius:14px;

    margin-bottom:20px;

    outline:none;

    font-size:16px;

}

button{

    background:linear-gradient(45deg,#ff4f9a,#ff6fb8);

    color:white;

    border:none;

    padding:14px 30px;

    border-radius:30px;

    cursor:pointer;

    font-size:17px;

    transition:.35s;

}

button:hover{

    transform:translateY(-4px);

    box-shadow:
    0 10px 25px rgba(255,80,150,.45);

}

small{

    display:block;

    margin-top:20px;

    color:#bbb;

}

/* Loading Page */

#loadingPage{

    display:none;

    height:100vh;

    justify-content:center;

    align-items:center;

    flex-direction:column;

}

.loader{

    width:320px;

    height:14px;

    background:#222;

    border-radius:50px;

    overflow:hidden;

    margin-top:20px;

}

.progress{

    width:0%;

    height:100%;

    background:linear-gradient(90deg,#ff4f9a,#ffd166);

}

/* Main Website */

#mainWebsite{

    display:none;

}

/* Hero */

.hero{

    height:100vh;

    display:flex;

    flex-direction:column;

    justify-content:center;

    align-items:center;

    text-align:center;

    padding:20px;

}

.hero h1{

    font-family:'Dancing Script',cursive;

    font-size:4rem;

    color:#ff8dc7;

    text-shadow:
    0 0 30px rgba(255,105,180,.8);

}

.hero p{

    margin-top:20px;

    color:#ddd;

    font-size:20px;

    max-width:700px;

    line-height:1.8;

}

.hero button{

    margin-top:35px;

}

/* Sections */

section{

    padding:90px 8%;

}

/* Envelope */

.envelope{

    width:320px;

    margin:auto;

    padding:30px;

    border-radius:20px;

    background:rgba(255,255,255,.06);

    backdrop-filter:blur(12px);

    transition:.5s;

}

.envelope:hover{

    transform:scale(1.03);

}

.letter{

    display:none;

}

.letter h2{

    color:#ff8dc7;

    margin-bottom:15px;

}

.letter p{

    color:#f2f2f2;

    line-height:1.9;

    white-space:pre-line;

}

/* Counter */

.counter{

    text-align:center;

}

.counter h2{

    color:#ffd166;

    margin-bottom:30px;

}

#loveCounter{

    display:grid;

    grid-template-columns:repeat(auto-fit,minmax(120px,1fr));

    gap:20px;

    max-width:700px;

    margin:auto;

}

#loveCounter div{

    background:rgba(255,255,255,.08);

    padding:25px;

    border-radius:18px;

    backdrop-filter:blur(10px);

}
